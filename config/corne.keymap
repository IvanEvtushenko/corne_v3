#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define NAV 1
#define SYM 2
#define ADJ 3

#define BTAB    &browsertab
#define CAPS    &caps_word
#define SUNL    &studio_unlock
#define BOOT    &bootloader
#define BT0     &bt BT_SEL 0
#define BT1     &bt BT_SEL 1
#define BT2     &bt BT_SEL 2
#define BTC     &bt BT_CLR
#define BTCA    &bt BT_CLR_ALL

/ {
    macros {
        browsertab: browsertab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LCTRL>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ──────────────────────────────── BASE ────────────────────────────────
        // ┌─────┬─────┬─────┬─────┬─────┬─────┐    ┌─────┬─────┬─────┬─────┬─────┬─────┐
        // │ ESC │  Q  │  W  │  E  │  R  │  T  │    │  Y  │  U  │  I  │  O  │  P  │BSPC │
        // │ TAB │  A  │  S  │  D  │  F  │  G  │    │  H  │  J  │  K  │  L  │  ;  │  '  │
        // │LCTL │  Z  │  X  │  C  │  V  │  B  │    │  N  │  M  │  ,  │  .  │  /  │RSFT │
        // └─────┴─────┴─────┼─────┼─────┼─────┤    ├─────┼─────┼─────┼─────┴─────┴─────┘
        //                   │ GUI │ NAV │ SPC │    │ ENT │ SYM │ ALT │
        //                   └─────┴─────┴─────┘    └─────┴─────┴─────┘
        DEF {
            display-name = "Base";
            bindings = <
&kp ESC      &kp Q        &kp W        &kp E        &kp R        &kp T            &kp Y        &kp U        &kp I        &kp O        &kp P        &kp BSPC
&kp TAB      &kp A        &kp S        &kp D        &kp F        &kp G            &kp H        &kp J        &kp K        &kp L        &kp SEMI     &kp SQT
&kp LCTRL    &kp Z        &kp X        &kp C        &kp V        &kp B            &kp N        &kp M        &kp COMMA    &kp DOT      &kp FSLH     &kp RSHFT
                                       &kp LGUI     &mo NAV      &kp SPACE        &kp RET      &mo SYM      &kp LALT
            >;
        };

        // ─────────────────────────────── NAVNUM ───────────────────────────────
        // ┌─────┬─────┬─────┬─────┬─────┬─────┐    ┌─────┬─────┬─────┬─────┬─────┬─────┐
        // │     │  1  │  2  │  3  │  4  │  5  │    │  6  │  7  │  8  │  9  │  0  │ DEL │
        // │CAPS │     │     │  ↑  │BTAB │     │    │     │HOME │PgUp │PgDn │ END │     │
        // │     │     │  ←  │  ↓  │  →  │     │    │     │     │     │     │     │     │
        // └─────┴─────┴─────┼─────┼─────┼─────┤    ├─────┼─────┼─────┼─────┴─────┴─────┘
        //                   │     │     │ SPC │    │ ENT │     │     │
        //                   └─────┴─────┴─────┘    └─────┴─────┴─────┘
        NAV {
            display-name = "NavNum";
            bindings = <
&trans       &kp N1       &kp N2       &kp N3       &kp N4       &kp N5           &kp N6       &kp N7       &kp N8       &kp N9       &kp N0       &kp DEL
CAPS         &trans       &trans       &kp UP       BTAB         &trans           &trans       &kp HOME     &kp PG_UP    &kp PG_DN    &kp END      &trans
&trans       &trans       &kp LEFT     &kp DOWN     &kp RIGHT    &trans           &trans       &trans       &trans       &trans       &trans       &trans
                                       &trans       &trans       &kp SPACE        &kp RET      &trans       &trans
            >;
        };

        // ─────────────────────────────── SYMBOLS ──────────────────────────────
        // ┌─────┬─────┬─────┬─────┬─────┬─────┐    ┌─────┬─────┬─────┬─────┬─────┬─────┐
        // │     │  !  │  @  │  #  │  $  │  %  │    │  ^  │  &  │  *  │  (  │  )  │     │
        // │     │  "  │     │  ?  │  /  │  `  │    │  -  │  =  │  [  │  ]  │  \  │     │
        // │     │     │     │  <  │  >  │  ~  │    │  _  │  +  │  {  │  }  │  |  │     │
        // └─────┴─────┴─────┼─────┼─────┼─────┤    ├─────┼─────┼─────┼─────┴─────┴─────┘
        //                   │     │     │ SPC │    │ ENT │     │     │
        //                   └─────┴─────┴─────┘    └─────┴─────┴─────┘
        SYM {
            display-name = "Symbols";
            bindings = <
&trans       &kp EXCL     &kp AT       &kp HASH     &kp DLLR     &kp PRCNT        &kp CARET    &kp AMPS     &kp ASTRK    &kp LPAR     &kp RPAR     &trans
&trans       &kp DQT      &trans       &kp QMARK    &kp FSLH     &kp GRAVE        &kp MINUS    &kp EQUAL    &kp LBKT     &kp RBKT     &kp BSLH     &trans
&trans       &trans       &trans       &kp LT       &kp GT       &kp TILDE        &kp UNDER    &kp PLUS     &kp LBRC     &kp RBRC     &kp PIPE     &trans
                                       &trans       &trans       &kp SPACE        &kp RET      &trans       &trans
            >;
        };

        // ─────────────────────────────── SYSTEM ───────────────────────────────
        // ┌─────┬─────┬─────┬─────┬─────┬─────┐    ┌─────┬─────┬─────┬─────┬─────┬─────┐
        // │     │ F1  │ F2  │ F3  │ F4  │ F5  │    │ F6  │ F7  │ F8  │ F9  │ F10 │     │
        // │     │ F11 │ F12 │     │     │UNLK │    │     │     │     │     │     │BOOT │
        // │     │ BT0 │ BT1 │ BT2 │ BT- │BT-A │    │     │     │     │     │     │     │
        // └─────┴─────┴─────┼─────┼─────┼─────┤    ├─────┼─────┼─────┼─────┴─────┴─────┘
        //                   │     │     │     │    │     │     │     │
        //                   └─────┴─────┴─────┘    └─────┴─────┴─────┘
        ADJ {
            display-name = "System";
            bindings = <
&trans       &kp F1       &kp F2       &kp F3       &kp F4       &kp F5           &kp F6       &kp F7       &kp F8       &kp F9       &kp F10      &trans
&trans       &kp F11      &kp F12      &trans       &trans       SUNL             &trans       &trans       &trans       &trans       &trans       BOOT
&trans       BT0          BT1          BT2          BTC          BTCA             &trans       &trans       &trans       &trans       &trans       &trans
                                       &trans       &trans       &trans           &trans       &trans       &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        l3 {
            if-layers = <NAV SYM>;
            then-layer = <ADJ>;
        };
    };
};
